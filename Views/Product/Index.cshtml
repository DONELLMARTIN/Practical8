@model IEnumerable<Practical8.Models.Product>

@{
    ViewBag.Title = "Inventory Management";
}

<h2>Inventory Management</h2>

<p>
    @Html.ActionLink("Add New Product", "Create", "Product")
</p>

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.Quantity</td>
                <td>@product.Price.Value.ToString("0.00")</td>
                <td>
                    @Html.ActionLink(
                        "Edit", "Edit", "Product",
                        new { id = product.ProductId }, null)
                </td>
                <td>
                    @Html.ActionLink(
                        "Delete", "Delete", "Product",
                        new { id = product.ProductId }, null)
                </td>
            </tr>
        }
    </tbody>
</table>